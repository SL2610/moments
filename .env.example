# ============================================================
# Application
# ============================================================
# Public URL guests will use (through Cloudflare Tunnel).
PUBLIC_URL=https://your-domain.example.com
# Host port the web app is published on (localhost only).
WEB_PORT=2610
# Comma-separated origins allowed for CORS (the public URL + local dev).
CORS_ALLOWED_ORIGINS=https://your-domain.example.com,http://localhost:2610
# Set to false after you created your owner account to block new signups.
ALLOW_REGISTRATION=true
# Wedding wordmark shown on the guest page (baked into the web build).
EVENT_NAME=Your Names Here
EVENT_DATE=DD.MM.YYYY
# CHANGE ME: shared password guests type (with their phone + full name) to enter the site.
GUEST_PASSWORD=change-me-wedding-password

# ============================================================
# Database (internal only — never exposed to the internet)
# ============================================================
POSTGRES_DB=grabpic
POSTGRES_USER=grabpic
# CHANGE ME: any strong random string.
POSTGRES_PASSWORD=change-me-postgres-password

# ============================================================
# Authentication
# ============================================================
# CHANGE ME: JWT signing secret, at least 32 bytes.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# Admin dashboard login (the couple's own account). Set/change these and
# restart the api container to set that password -- no manual DB edits.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me

# ============================================================
# Storage
# ============================================================
# CHANGE ME: secret used to sign short-lived photo view URLs.
# Generate with: openssl rand -base64 48
VIEW_URL_SECRET=change-me-generate-with-openssl-rand-base64-48
# Max size of a single photo upload/import, in MB.
PHOTO_MAX_SIZE_MB=30
# Max photos per user across all albums.
MAX_PHOTOS_PER_USER=10000

# ============================================================
# AI face engine (v2: SCRFD-10G detection + AdaFace IR101 recognition)
# ============================================================
# cuda (NVIDIA GPU via docker-compose.gpu.yml) or cpu.
FACE_DEVICE=cpu
FACE_RECOGNIZER=adaface_ir101
# Max simultaneous model inferences (GPU memory safety); searches queue.
AI_INFERENCE_CONCURRENCY=2
# Detection: original photos are resized to this long side; group photos are
# additionally scanned in native-resolution tiles for small faces.
FACE_DETECTION_LONG_SIDE=2400
FACE_DETECTION_TILING=true
# Match thresholds (cosine similarity). UN-CALIBRATED DEVELOPMENT DEFAULTS:
# run `docker compose exec ai-search python calibrate.py` on labeled event
# faces and paste its recommendations here. (The old GhostFaceNet
# FACE_SEARCH_* knobs are obsolete and removed.)
FACE_STRICT_THRESHOLD=0.45
FACE_RECOVERY_THRESHOLD=0.34
FACE_MIN_SEED_QUALITY=0.45
# Save aligned face crops for admin debugging under data/photos/debug/faces.
STORE_DEBUG_FACE_CROPS=false
# Per-IP selfie search rate limit.
SEARCH_RATE_LIMIT=6/minute
# CHANGE ME to enable the AI admin/debug API (empty = disabled entirely).
ADMIN_DEBUG_TOKEN=

# ============================================================
# Queue
# ============================================================
# Attempts before a photo-processing job is marked FAILED.
JOB_MAX_ATTEMPTS=3

# ============================================================
# Cloudflare
# ============================================================
# Tunnel token from the Cloudflare Zero Trust dashboard
# (tunnel public hostname your-domain.example.com -> http://web:3000).
# Only needed when running the compose-managed tunnel:
#   docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Optional bot protection (leave blank to disable).
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=your-domain.example.com,localhost

# ============================================================
# Security / misc
# ============================================================
# Optional: allow guest selfie via file upload instead of camera (demo mode).
DEMO_SELFIE_UPLOAD=false
